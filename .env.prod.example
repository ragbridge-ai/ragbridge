# Configuration for docker-compose.prod.yml. Copy to .env.prod and fill in.
# .env.prod holds real secrets: never commit it (it is gitignored and is kept
# out of the Docker image).

# --- Required secrets ------------------------------------------------------
# Generate each with:  openssl rand -hex 24
# Hex, not base64: these end up inside URLs, and base64's / + = are URL
# delimiters that some parsers misread.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Public address --------------------------------------------------------
# A real domain pointing at this host gets an automatic Let's Encrypt
# certificate. "localhost" uses Caddy's local CA and is for trying the stack.
SITE_ADDRESS=localhost
# Host ports for the proxy. Change only if 80/443 are taken (for example when
# trying this stack on a machine that already runs something on them).
HTTP_PORT=80
HTTPS_PORT=443
# Largest request body the proxy accepts. Keep it a little above
# MAX_UPLOAD_SIZE (10 MB by default).
MAX_BODY=12MB

# --- Models ----------------------------------------------------------------
# Defaults use an Ollama running directly on the host. To use a hosted
# provider instead, set these to LiteLLM model names and add the provider's API
# key as an environment variable (for example ANTHROPIC_API_KEY=...).
# Never hard-code a key anywhere else.
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIMENSION=768
CHAT_MODEL=ollama/llama3.2
# A Linux host's Ollama listens on 127.0.0.1 by default, which containers
# cannot reach. Bind it to the Docker bridge or all interfaces
# (OLLAMA_HOST=0.0.0.0) and firewall port 11434 from the internet.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Optional --------------------------------------------------------------
# AGENT_MAX_STEPS=3
# AGENT_PLANNER_MODEL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
