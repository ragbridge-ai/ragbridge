# Copy this file to .env and adjust the values for your local setup.
# Never commit the real .env file.

APP_NAME=ragbridge

# "development" or "production". In production the app refuses to start if
# DATABASE_URL still uses the ragbridge:ragbridge credentials below - they are
# published in this file, so they are public. Generate a real one with:
#   openssl rand -hex 24
# (hex, not base64: the password sits inside a URL, and base64's / + = are
# URL delimiters that some parsers misread.)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ragbridge:ragbridge@localhost:5432/ragbridge
MAX_UPLOAD_SIZE=10000000

# Serve the generated API docs at /docs, /openapi.json and /redoc. Every
# endpoint needs an API key either way, so this controls whether the API's
# shape is public - not its data. Turn it off on a public deployment.
ENABLE_DOCS=true

# Embeddings and chat. Defaults use a local Ollama, which needs no API key.
# To use a hosted provider instead, change EMBEDDING_MODEL / CHAT_MODEL to a
# LiteLLM model name (for example "voyage/voyage-3" or "anthropic/claude-...")
# and set the matching API key as an environment variable.
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIMENSION=768
CHAT_MODEL=ollama/llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval. "hybrid" merges vector and keyword search with reciprocal rank
# fusion; set to "vector" or "keyword" to use only one arm. CANDIDATES is how
# many rows each arm returns before fusion (kept larger than a request's
# top_k on purpose - see docs/plans/phase-2.md).
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=20

# Reranking. Off by default - the default reranker needs no provider or API
# key. To enable it, set RERANK_ENABLED=true, RERANK_MODEL to a LiteLLM
# rerank model (for example "cohere/rerank-v3.5") and the matching API key.
RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-v3.5

# Background jobs. Uploads larger than ASYNC_PROCESSING_THRESHOLD bytes are
# processed by the worker (docker compose up runs it as its own service)
# instead of within the upload request.
REDIS_URL=redis://localhost:6379/0
ASYNC_PROCESSING_THRESHOLD=100000

# Caching. Embeddings are cached by default (a hit can never be stale - it's
# keyed by model and text). Whole answers are cached only if enabled, keyed
# by a per-tenant corpus version that any upload or delete bumps.
EMBEDDING_CACHE_TTL=86400
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL=3600

# Tracing and cost tracking. Off unless both keys are set - get them from
# a Langfuse project (cloud.langfuse.com or a self-hosted instance).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent mode (POST /agent). AGENT_MAX_STEPS is the hard ceiling on retrieval
# rounds per request. AGENT_PLANNER_MODEL is the LiteLLM model that decides
# what to search for next; empty reuses CHAT_MODEL. Planning needs reliable
# JSON output, so a stronger model here can help if CHAT_MODEL is small.
AGENT_MAX_STEPS=3
AGENT_PLANNER_MODEL=
